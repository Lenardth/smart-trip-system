# Environment
.env
.env.*
!.env.example

# Laravel dependencies and generated assets
/vendor
/node_modules
/public/hot
/public/storage
/storage/*.key
/bootstrap/cache/*
/storage/pail

# Local databases and generated test state
/database.sqlite
/.phpunit.cache
/.phpunit.result.cache
/coverage

# Logs and runtime files
*.log
npm-debug.log
yarn-error.log

# IDE helpers and editor state
.phpactor.json
/.fleet
/.idea
/.nova
/.vscode
/.zed
/auth.json
Homestead.json
Homestead.yaml
_ide_helper.php
.phpstorm.meta.php
_ide_helper_models.php
/.styleci.yml
/.php_cs
.php_cs.cache
docker-compose.override.yml

# OS files
.DS_Store
Thumbs.db

# Backups and temporary caches
*.backup
*.bak
*.cache

# Framework runtime directories
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore

# NOTE: public/build is intentionally committed for deployment.
