APP_NAME="Smart Booking"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app.vercel.app

LOG_CHANNEL=stderr
LOG_LEVEL=error

# ── Database ──────────────────────────────────────────────────────────────────
# For Vercel: set DATABASE_URL to your Neon/Supabase/Railway Postgres URL
# e.g. postgresql://user:pass@host/dbname?sslmode=require
DATABASE_URL=

# Local SQLite (development only)
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# ── Cache / Session / Queue ───────────────────────────────────────────────────
BROADCAST_DRIVER=log
CACHE_DRIVER=array
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=cookie
SESSION_LIFETIME=120

# ── Mail ──────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@smartbooking.app"
MAIL_FROM_NAME="${APP_NAME}"

# ── AI (Groq) ─────────────────────────────────────────────────────────────────
AI_DEFAULT_PROVIDER=groq
GROQ_API_KEY=
GROQ_URL=https://api.groq.com

# ── Pusher / Real-time (optional) ─────────────────────────────────────────────
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ── AWS S3 (optional — for file uploads in production) ────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
