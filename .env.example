APP_NAME="Smart Booking"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# Security: Set to * for development, specific IPs for production
TRUSTED_PROXIES=*

LOG_CHANNEL=stderr
LOG_LEVEL=error

DATABASE_URL=
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

BROADCAST_DRIVER=log
CACHE_DRIVER=array
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Security: Set to true in production with HTTPS
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@smartbooking.app"
MAIL_FROM_NAME="${APP_NAME}"

# Pricing Configuration
SERVICE_FEE_RATE=0.05
AGENCY_COMMISSION=0.10
TAX_RATE=0.05
DEFAULT_CURRENCY=USD
DEFAULT_CURRENCY_SYMBOL=$

# AI Configuration
AI_DEFAULT_PROVIDER=groq
GROQ_API_KEY=
GROQ_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=2048

# Third-Party API Keys
AVIATIONSTACK_KEY=
GEOAPIFY_KEY=
GNEWS_API_KEY=
NEWSAPI_KEY=
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# External Pricing APIs (Optional - will use intelligent estimation if not provided)
SKYSCANNER_RAPIDAPI_KEY=
BOOKING_RAPIDAPI_KEY=

# Free APIs for Destination Validation (No keys needed - automatically used)
# - REST Countries API: Country validation, currency, languages
# - OpenStreetMap Nominatim: Location validation, coordinates
# - Open-Meteo: Weather data for best time to visit
# - Teleport API: Cost of living data
# - Travel Advisory API: Safety ratings and travel warnings
# These APIs help prevent AI hallucinations by cross-referencing real data

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
